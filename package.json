{
  "name": "@coresys/cscl-ui",
  "version": "2.0.1",
  "description": "CoreSys component library: React + Tailwind v4 components, tokens and motion shared by every CoreSys app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coresys-dev/cscl-ui.git"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "theme"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js"
    },
    "./theme.css": "./theme/index.css",
    "./theme/*": "./theme/*",
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm.mjs",
    "prepare": "tsc -p tsconfig.build.json && node scripts/fix-esm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.*\"",
    "check": "pnpm typecheck && pnpm test",
    "showroom": "pnpm --dir showroom dev",
    "format": "prettier --write src theme"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2",
    "@tiptap/core": "^3",
    "@tiptap/extension-list": "^3",
    "@tiptap/extensions": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/suggestion": "^3",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1",
    "marked": ">=15",
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "tailwind-merge": "^3",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "marked": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "marked": "18.0.14",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "~5.8.3"
  }
}
